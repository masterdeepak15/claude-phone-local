{
  "name": "claude-phone-local",
  "version": "2.0.0",
  "description": "Local/offline fork of NetworkChuck's claude-phone: talk to Claude Code over 3CX/SIP with faster-whisper STT + Piper TTS in one Docker container.",
  "type": "module",
  "bin": {
    "claude-phone": "./cli/bin/claude-phone.js"
  },
  "files": [
    "cli/bin",
    "cli/lib",
    "cli/README.md",
    "voice-app",
    "claude-api-server",
    "stt-local",
    "tts-local",
    "Dockerfile",
    "mcp-server",
    "docker",
    "docker-compose.yml",
    ".env.example",
    "README.md",
    "docs",
    "!voice-app/config/devices.json",
    "!voice-app/audio/**",
    "!voice-app/audio-temp/**",
    "!tts-local/voices/**",
    "!**/.env",
    "!**/node_modules/**"
  ],
  "scripts": {
    "postinstall": "node ./cli/bin/postinstall.js || true",
    "prepublishOnly": "node ./cli/bin/check-publish-safety.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "voice",
    "sip",
    "3cx",
    "ai",
    "whisper",
    "piper",
    "offline",
    "self-hosted",
    "hindi",
    "marathi",
    "multilingual",
    "voip",
    "freeswitch",
    "drachtio"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "inquirer": "^9.2.15",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "axios": "^1.6.7",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theNetworkChuck/claude-phone.git"
  }
}
